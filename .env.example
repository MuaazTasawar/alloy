# ── Postgres (shared by rag-service, gateway) ──
POSTGRES_USER=alloy
POSTGRES_PASSWORD=alloy_dev_password
POSTGRES_DB=alloy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://alloy:alloy_dev_password@postgres:5432/alloy?sslmode=disable

# ── Redis (job queue + response caching) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Service ports ──
GATEWAY_PORT=8080
RAG_SERVICE_PORT=8001
FINETUNE_SERVICE_PORT=8002
JUDGE_SERVICE_PORT=8003
DASHBOARD_PORT=3000

# ── Service URLs (how the gateway reaches each service) ──
RAG_SERVICE_URL=http://rag-service:8001
FINETUNE_SERVICE_URL=http://finetune-service:8002
JUDGE_SERVICE_URL=http://judge-service:8003

# ── Embeddings + base model config (rag-service) ──
# TODO: put a HuggingFace access token here if the embedding/base model is gated
HF_TOKEN=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
BASE_MODEL=microsoft/Phi-3-mini-4k-instruct

# ── Fine-tuned model config (finetune-service) ──
FINETUNE_BASE_MODEL=meta-llama/Llama-3.2-3B-Instruct
LORA_OUTPUT_DIR=/app/adapters/latest

# ── LLM-as-judge (judge-service) ──
# TODO: put your real Anthropic API key here — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-4-6

# ── Dashboard ──
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080